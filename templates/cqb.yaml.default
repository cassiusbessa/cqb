# CQB consumer config.
# Constitution (not overridable): diff-only, new-func absolute complexity,
# legacy is delta, yellow never fails git, empty strict_paths until a human
# names a scope, hook file may be attached locally, execution still needs
# CQB=1, the agent is not the git exit code.
#
# Nested module: set prefix in this file (or prefixes, most-specific first).
# Globs in globs.txt / testable / strict_paths may be written relative to
# that module (internal/...) even when git paths are services/billing/internal/....
kit_version: "0.1.0"
prefix: ""
operator_language: "pt-BR"
complexity:
  cognitive: 30
  cyclomatic: 30
  nested_if: 5
  delta: 5
strict_paths: []
# Empty = hunters/cover cannot be red (not an ignore list).
# After a human names a recorte, e.g. internal/billing/** — content hunters /
# low cover there WILL exit 1: /cqb treats it as a blocker and CQB=1 git push stops.
# Missing TestFoo stays yellow; cover holds that red on the list.
testable:
  include:
    - "internal/"
  exclude:
    - "internal/interface/"
io_imports:
  - "database/sql"
  - "net/http"
  - "os"
extra_hunters: []
e2e:
  catalog_root: "internal/e2e"
cover:
  io_floor: 80
  baseline_path: ".cqb/cover-baseline.json"
